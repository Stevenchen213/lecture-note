# Azure Speech Services (语音识别)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=japaneast

# DeepSeek API (翻译 + 大纲生成)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：切换到任何 OpenAI 兼容 LLM（如 Kimi/Moonshot），设置后覆盖上面的 DeepSeek
# 注意：Kimi 旧模型(moonshot-v1/kimi-k2系列)已全部停服，当前在售为 kimi-k2.6 / kimi-k3 等
# 切换后 temperature 默认不再发送（Kimi 新模型该参数被锁定，传参会报错），可用 LLM_TEMPERATURE 强制指定
# 国际站 https://api.moonshot.ai/v1（最低充$1）；国内站 https://api.moonshot.cn/v1
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k2.6
# LLM_API_KEY=your_kimi_api_key_here

# 前端 WebSocket 地址（仅生产环境需要，本地开发默认 localhost:8080）
# VITE_WS_URL=wss://your-server.railway.app
